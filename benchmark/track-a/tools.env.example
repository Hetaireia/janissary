# Example tools.env for track-a. Copy to tools.env and edit.
# All keys optional; the runner has safe defaults for each.

# Path to the janissary executable. If left blank, uses whatever is on PATH.
JANISSARY_BIN=janissary
JANISSARY_TIMEOUT=30

# Path to the nuclei binary. If left blank, uses PATH.
NUCLEI_BIN=nuclei
NUCLEI_TIMEOUT=3600
# Restrict to specific template tags/severities; leave blank to use defaults.
NUCLEI_SEVERITY=critical,high,medium
NUCLEI_TEMPLATES=

# ZAP baseline image + wall-clock cap in minutes.
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
ZAP_MINUTES=10
ZAP_TIMEOUT=1800

# Pin the OWASP Benchmark version under test. Record the exact commit
# hash or image tag here at the time of the first official run.
TARGET_VERSION=unpinned