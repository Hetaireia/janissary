# Example tools.env for track-b. Copy to tools.env and edit.
# All keys optional; the runner has safe defaults for each.

# Pin the OWASP Juice Shop image tag and, at run time, the Cloudflare
# config under test (defaults only - no tuned rules).
TARGET_VERSION=juice-shop-v17.1.1-cf-free-default

# JANISSARY invocation. The param must exist on the target; for Juice
# Shop the search endpoint is /rest/products/search?q=...
JANISSARY_BIN=janissary
JANISSARY_PARAM=q

# Nuclei binary and template set. Pin the template directory at run time
# (the pre-registration forbids using nuclei's defaults).
NUCLEI_BIN=nuclei
NUCLEI_SEVERITY=critical,high,medium
NUCLEI_TEMPLATES=

# ZAP baseline image + wall-clock cap.
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
ZAP_MINUTES=10