# tools_tuned.env - tuned arm for 7.5.0 baseline runs
# Pre-registered alternative; both arms run.
# Differences vs default (logged in Amendment 23):
#   - Higher per-case timeout (cooperates with FN-recovery)
#   - ZAP wall-clock doubled (aligns with competitor comparison)
JANISSARY_BIN=janissary
JANISSARY_TIMEOUT=300
NUCLEI_BIN=nuclei
NUCLEI_TIMEOUT=3600
NUCLEI_SEVERITY=critical,high,medium
NUCLEI_TEMPLATES=
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
ZAP_MINUTES=20
ZAP_TIMEOUT=1800
TARGET_VERSION=20cbf3d11123347e47ed89541e6942836def53f7