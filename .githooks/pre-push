#!/bin/sh
# LF only. Uses this repository's Windows .venv under Git for Windows.
# Refuses a v* tag whose commit does not declare the matching version.
# stdin is filtered of blank lines and buffered so the tag check can consume
# it without eating the stream pre-commit needs; the buffer is reopened at
# offset 0, then unlinked, then handed over on fd 3 so nothing is left behind.
export PATH=".venv/Scripts:$PATH"
set -u

tmp=$(mktemp 2>/dev/null) || { echo "pre-push: mktemp failed"; exit 1; }

# git never sends a blank line and pre-commit cannot parse one, so they are
# dropped here; what is left is either usable or empty.
grep -v '^[[:space:]]*$' > "$tmp" || :

# pre-commit cannot parse an empty stdin either, so synthesise a branch line.
if [ ! -s "$tmp" ]; then
  h=$(git rev-parse --verify --quiet HEAD || :)
  b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || :)
  if [ -n "$h" ] && [ -n "$b" ]; then
    printf "%s %s %s %s\n" "refs/heads/$b" "$h" "refs/heads/$b" "$h" > "$tmp"
  fi
fi

bad=0
while read -r lref lsha rref rsha; do
  case "$lref" in
    refs/tags/v[0-9]*) ;;
    *) continue ;;
  esac
  tag=${lref#refs/tags/}
  if ! commit=$(git rev-parse --verify --quiet "$lsha^{commit}"); then
    echo "pre-push: cannot resolve $tag ($lsha) to a commit"
    bad=1
    continue
  fi
  ver=$(git show "$commit:pyproject.toml" 2>/dev/null | sed -n 's/^version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
  if [ -z "$ver" ]; then
    echo "pre-push: no [project].version readable at $tag ($commit)"
    bad=1
    continue
  fi
  if [ "v$ver" != "$tag" ]; then
    echo "pre-push: $tag points at $commit, which declares version $ver"
    echo "pre-push: commit the version bump first, then tag the bump commit"
    bad=1
    continue
  fi
  echo "pre-push: $tag ok (version $ver at $commit)"
done < "$tmp"

exec 3< "$tmp"
rm -f "$tmp"

if [ "$bad" -ne 0 ]; then
  echo "pre-push: tag/version check failed"
  exit 1
fi

exec ".venv/Scripts/pre-commit.exe" hook-impl --config=.pre-commit-config.yaml --hook-type=pre-push --hook-dir . -- "$@" <&3
